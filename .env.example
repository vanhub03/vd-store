# Shared
NODE_ENV=development
API_BASE_URL=http://localhost:3000
BOT_INTERNAL_TOKEN=change-me-internal-token
JWT_SECRET=change-me-jwt-secret
PARTNER_API_ENABLED=true
PARTNER_WEBHOOK_ENCRYPTION_KEY=change-me-partner-webhook-encryption-key
PARTNER_WEBHOOK_CONCURRENCY=5

# Database / queues
DATABASE_URL=postgresql://vdstore:vdstore@localhost:5432/vdstore?schema=public
REDIS_URL=redis://localhost:6379

# First admin seed
ADMIN_EMAIL=admin@vd-store.local
ADMIN_PASSWORD=admin123456

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling
TELEGRAM_WEBHOOK_PUBLIC_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
BOT_PORT=3001
ADMIN_TELEGRAM_USERNAME=vanhdao99
# Optional separate bot token for admin-only manual-order alerts. Falls back to TELEGRAM_BOT_TOKEN if empty.
ADMIN_TELEGRAM_BOT_TOKEN=
# Numeric/private chat id for admin manual-order alerts. Telegram bots cannot DM @username directly.
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_PUBLIC_URL=https://admin.vanhdao.io.vn

# SePay webhook auth. Prefer HMAC in production.
SEPAY_AUTH_MODE=auto
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=

# VietQR image generation
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=VD STORE
VIETQR_TEMPLATE=compact2
VIETQR_IMAGE_BASE_URL=https://img.vietqr.io/image

# Cryptomus / USDT checkout
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=
CRYPTOMUS_WEBHOOK_AUTH_MODE=sign
CRYPTOMUS_API_BASE_URL=https://api.cryptomus.com
CRYPTOMUS_NETWORK=bsc
CRYPTOMUS_WEBHOOK_URL=https://api.example.com/webhooks/cryptomus
CRYPTOMUS_RETURN_URL=https://example.com
CRYPTOMUS_SUCCESS_URL=https://example.com
USDT_VND_RATE=26000
QR_IMAGE_BASE_URL=https://api.qrserver.com/v1/create-qr-code/
WEB_PUBLIC_URL=https://example.com

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_GA_MEASUREMENT_ID=

# Google Analytics admin reports
GA_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
