generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum CustomerRole {
  CUSTOMER
  COLLABORATOR
}

enum ProductDeliveryType {
  STOCK_ITEM
  SHARED_CONTENT
  MANUAL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  AVAILABLE
  SOLD
  DISABLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_FULFILLMENT
  PAID
  FULFILLED
  EXPIRED
  CANCELLED
  CREDITED_TO_WALLET
  MANUAL_REVIEW
}

enum PartnerEnvironment {
  LIVE
  TEST
}

enum PartnerOrderStatus {
  PENDING_FULFILLMENT
  PARTIALLY_FULFILLED
  FULFILLED
  PARTIALLY_CANCELLED
  CANCELLED
}

enum PartnerOrderItemStatus {
  PENDING_FULFILLMENT
  FULFILLED
  CANCELLED
}

enum ApiIdempotencyStatus {
  PENDING
  COMPLETED
}

enum PartnerWebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ManualOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentKind {
  TOPUP
  DIRECT_ORDER
  WALLET_PURCHASE
  ADMIN_ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  EXPIRED
  FAILED
  CREDITED_TO_WALLET
  MANUAL_REVIEW
}

enum WalletEntryType {
  TOPUP
  PURCHASE
  REFUND
  DIRECT_PAYMENT_CREDIT
  ADMIN_ADJUSTMENT
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum BroadcastDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentMethod {
  WALLET
  BANK_TRANSFER
  BINANCE_PAY
  CRYPTOMUS
}

model TelegramUser {
  id           String   @id @default(cuid())
  telegramId   String   @unique
  email        String?  @unique
  passwordHash String?
  displayName  String?
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  role         CustomerRole @default(CUSTOMER)
  isBlocked    Boolean  @default(false)
  partnerApiEnabled Boolean @default(false)
  partnerReadRateLimit Int @default(120)
  partnerWriteRateLimit Int @default(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders              Order[]
  payments            Payment[]
  walletEntries       WalletLedgerEntry[]
  broadcastDeliveries BroadcastDelivery[]
  reviews             ProductReview[]
  voucherRedemptions  VoucherRedemption[]
  voucherAssignments  VoucherAssignment[]
  partnerApiCredentials PartnerApiCredential[]
  partnerOrders         PartnerOrder[]
  partnerWebhookEndpoints PartnerWebhookEndpoint[]
  apiIdempotencyRecords ApiIdempotencyRecord[]

  @@index([role, isBlocked])
  @@index([isBlocked, createdAt])
  @@index([createdAt])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs  AuditLog[]
  broadcasts Broadcast[]
  vouchers   Voucher[]
  voucherAssignments VoucherAssignment[]
  partnerApiCredentials PartnerApiCredential[]
  updatedSettings StoreSetting[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([active, sortOrder, name])
}

model Product {
  id                 String              @id @default(cuid())
  categoryId         String?
  name               String
  nameEn             String?
  slug               String              @unique
  description        String?
  descriptionEn      String?
  imageUrl           String?
  buttonIcon         String              @default("🛍️")
  price              Int
  botPrice           Int                 @default(0)
  webPrice           Int                 @default(0)
  usdtPrice          Decimal?            @db.Decimal(18, 8)
  collaboratorDiscountPercent Int        @default(0)
  showInBot          Boolean             @default(true)
  showInWeb          Boolean             @default(true)
  status             ProductStatus       @default(ACTIVE)
  deliveryType       ProductDeliveryType
  sharedContent      String?
  sharedFilePath     String?
  manualInstructions String              @default("Vui lòng ib admin @vanhdao99 để nhận hàng.")
  manualStock        Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  orders         Order[]
  reviews        ProductReview[]
  partnerOrderItems PartnerOrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([status, showInWeb, categoryId, createdAt])
  @@index([status, showInBot, categoryId, createdAt])
  @@index([createdAt])
}

model ProductReview {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model InventoryItem {
  id        String          @id @default(cuid())
  productId String
  content   String
  status    InventoryStatus @default(AVAILABLE)
  orderId   String?
  soldAt    DateTime?
  createdAt DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

model Order {
  id              String            @id @default(cuid())
  code            String            @unique
  checkoutGroupId String?
  userId          String
  productId       String
  quantity        Int               @default(1)
  unitPrice       Int
  subtotalAmount  Int               @default(0)
  discountAmount  Int               @default(0)
  collaboratorDiscountPercent Int   @default(0)
  collaboratorDiscountAmount  Int   @default(0)
  voucherDiscountAmount       Int   @default(0)
  customerRoleSnapshot        CustomerRole @default(CUSTOMER)
  totalAmount     Int
  status          OrderStatus
  manualStatus    ManualOrderStatus @default(PENDING)
  paymentMethod   PaymentMethod
  voucherCode     String?
  voucherId       String?
  deliveryText    String?
  expiresAt       DateTime?
  fulfilledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user              TelegramUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  voucher           Voucher?            @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  payments          Payment[]
  inventoryItems    InventoryItem[]
  walletEntries     WalletLedgerEntry[]
  voucherRedemption VoucherRedemption?
  partnerOrderItem  PartnerOrderItem?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([manualStatus, createdAt])
  @@index([voucherId])
  @@index([checkoutGroupId])
  @@index([customerRoleSnapshot, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod, createdAt])
}

model Voucher {
  id                String   @id @default(cuid())
  code              String   @unique
  discountPercent   Int
  maxDiscountAmount Int?
  maxDiscountUsdt   Decimal? @db.Decimal(18, 8)
  active            Boolean  @default(true)
  firstOrderOnly    Boolean  @default(false)
  allowCollaboratorStacking Boolean @default(false)
  maxUses           Int?
  usedCount         Int      @default(0)
  startsAt          DateTime @default(now())
  expiresAt         DateTime
  createdByAdminId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy   Admin?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  orders      Order[]
  redemptions VoucherRedemption[]
  assignments VoucherAssignment[]

  @@index([active, expiresAt])
  @@index([createdByAdminId])
}

model VoucherAssignment {
  id                String    @id @default(cuid())
  voucherId         String
  userId            String
  assignedByAdminId String?
  revokedAt         DateTime?
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  voucher         Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user            TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByAdmin Admin?       @relation(fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@unique([voucherId, userId])
  @@index([userId, createdAt])
  @@index([userId, revokedAt, usedAt, createdAt])
  @@index([voucherId, createdAt])
  @@index([voucherId, revokedAt, usedAt])
}

model VoucherRedemption {
  id                   String   @id @default(cuid())
  voucherId            String
  userId               String
  orderId              String   @unique
  subtotalAmount       Int
  discountAmount       Int
  totalAmount          Int
  claimIpHash          String?
  claimFingerprintHash String?
  createdAt            DateTime @default(now())

  voucher Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId])
  @@unique([voucherId, claimFingerprintHash])
  @@index([userId, createdAt])
  @@index([voucherId, createdAt])
  @@index([voucherId, claimIpHash])
}

model Payment {
  id                String        @id @default(cuid())
  code              String        @unique
  kind              PaymentKind
  status            PaymentStatus
  amount            Int
  expectedAmount    Int?
  userId            String?
  orderId           String?
  expiresAt         DateTime?
  qrImageUrl        String?
  qrPayload         String?
  provider          String        @default("sepay")
  cryptoCurrency    String?
  cryptoAmount      Decimal?      @db.Decimal(18, 8)
  quotedExchangeRate Decimal?     @db.Decimal(18, 4)
  providerPaymentId String?
  checkoutUrl       String?
  deeplink          String?
  providerPayload   Json?
  telegramChatId    String?
  telegramMessageId Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user             TelegramUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  walletEntries    WalletLedgerEntry[]
  bankTransactions BankTransaction[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([provider, providerPaymentId])
  @@index([provider, status])
  @@index([createdAt])
}

model PartnerApiCredential {
  id               String             @id @default(cuid())
  userId           String
  createdByAdminId String?
  environment      PartnerEnvironment
  label            String
  keyPrefix        String
  keyHash          String             @unique
  scopes           String[]
  expiresAt        DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user      TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy Admin?       @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, environment, revokedAt])
  @@index([expiresAt])
}

model PartnerOrder {
  id                         String             @id @default(cuid())
  userId                     String
  environment                PartnerEnvironment
  externalOrderId            String
  status                     PartnerOrderStatus
  currency                   String             @default("VND")
  subtotalAmount             Int
  collaboratorDiscountAmount Int                @default(0)
  voucherDiscountAmount      Int                @default(0)
  totalAmount                Int
  refundedAmount             Int                @default(0)
  voucherCode                String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  user          TelegramUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         PartnerOrderItem[]
  webhookEvents PartnerWebhookEvent[]

  @@unique([userId, environment, externalOrderId])
  @@index([userId, environment, createdAt])
  @@index([status, createdAt])
}

model PartnerOrderItem {
  id                         String                 @id @default(cuid())
  partnerOrderId             String
  productId                  String
  sourceOrderId              String?                @unique
  productName                String
  deliveryType               ProductDeliveryType
  quantity                   Int
  unitPrice                  Int
  subtotalAmount             Int
  collaboratorDiscountAmount Int                    @default(0)
  voucherDiscountAmount      Int                    @default(0)
  totalAmount                Int
  status                     PartnerOrderItemStatus
  deliveryText               String?
  refundedAt                 DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  partnerOrder PartnerOrder @relation(fields: [partnerOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceOrder  Order?       @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)

  @@index([partnerOrderId, status])
  @@index([productId])
}

model ApiIdempotencyRecord {
  id             String               @id @default(cuid())
  userId         String
  environment    PartnerEnvironment
  idempotencyKey String
  requestHash    String
  status         ApiIdempotencyStatus @default(PENDING)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, environment, idempotencyKey])
  @@index([expiresAt])
}

model PartnerWebhookEndpoint {
  id               String             @id @default(cuid())
  userId           String
  environment      PartnerEnvironment
  url              String
  secretCiphertext String
  secretIv         String
  secretTag        String
  enabled          Boolean            @default(true)
  events           String[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user   TelegramUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventsLog PartnerWebhookEvent[]

  @@unique([userId, environment])
}

model PartnerWebhookEvent {
  id             String   @id @default(cuid())
  endpointId     String
  partnerOrderId String?
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  endpoint     PartnerWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  partnerOrder PartnerOrder?          @relation(fields: [partnerOrderId], references: [id], onDelete: SetNull)
  delivery     PartnerWebhookDelivery?

  @@index([endpointId, createdAt])
  @@index([partnerOrderId])
}

model PartnerWebhookDelivery {
  id             String                       @id @default(cuid())
  eventId        String                       @unique
  status         PartnerWebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                          @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  event PartnerWebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model StoreSetting {
  key              String   @id
  value            String
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  updatedBy Admin? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)
}

model WalletLedgerEntry {
  id                 String          @id @default(cuid())
  userId             String
  amount             Int
  type               WalletEntryType
  referencePaymentId String?
  referenceOrderId   String?
  note               String?
  createdAt          DateTime        @default(now())

  user             TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  referencePayment Payment?     @relation(fields: [referencePaymentId], references: [id], onDelete: SetNull)
  referenceOrder   Order?       @relation(fields: [referenceOrderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([referencePaymentId])
  @@index([referenceOrderId])
  @@index([createdAt])
}

model BankTransaction {
  id                    String    @id @default(cuid())
  provider              String    @default("sepay")
  providerTransactionId String    @unique
  gateway               String?
  transactionDate       DateTime?
  accountNumber         String?
  subAccount            String?
  code                  String?
  content               String?
  transferType          String?
  transferAmount        Int
  accumulated           Int?
  referenceCode         String?
  rawPayload            Json
  paymentId             String?
  createdAt             DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([paymentId])
  @@index([provider, transactionDate])
}

model Broadcast {
  id               String          @id @default(cuid())
  title            String
  message          String
  status           BroadcastStatus @default(DRAFT)
  target           String          @default("all")
  sentCount        Int             @default(0)
  failedCount      Int             @default(0)
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  createdBy  Admin?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  deliveries BroadcastDelivery[]

  @@index([status, createdAt])
}

model BroadcastDelivery {
  id          String                  @id @default(cuid())
  broadcastId String
  userId      String
  status      BroadcastDeliveryStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime                @default(now())

  broadcast Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorAdminId String?
  action       String
  entityType   String
  entityId     String?
  meta         Json?
  createdAt    DateTime @default(now())

  actorAdmin Admin? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([actorAdminId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
