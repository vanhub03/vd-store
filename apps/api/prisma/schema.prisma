generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum CustomerRole {
  CUSTOMER
  COLLABORATOR
}

enum ProductDeliveryType {
  STOCK_ITEM
  SHARED_CONTENT
  MANUAL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  AVAILABLE
  SOLD
  DISABLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  EXPIRED
  CANCELLED
  CREDITED_TO_WALLET
  MANUAL_REVIEW
}

enum ManualOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentKind {
  TOPUP
  DIRECT_ORDER
  WALLET_PURCHASE
  ADMIN_ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  EXPIRED
  FAILED
  CREDITED_TO_WALLET
  MANUAL_REVIEW
}

enum WalletEntryType {
  TOPUP
  PURCHASE
  REFUND
  DIRECT_PAYMENT_CREDIT
  ADMIN_ADJUSTMENT
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum BroadcastDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentMethod {
  WALLET
  BANK_TRANSFER
  BINANCE_PAY
  CRYPTOMUS
}

model TelegramUser {
  id           String   @id @default(cuid())
  telegramId   String   @unique
  email        String?  @unique
  passwordHash String?
  displayName  String?
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  role         CustomerRole @default(CUSTOMER)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders              Order[]
  payments            Payment[]
  walletEntries       WalletLedgerEntry[]
  broadcastDeliveries BroadcastDelivery[]
  reviews             ProductReview[]
  voucherRedemptions  VoucherRedemption[]

  @@index([role, isBlocked])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs  AuditLog[]
  broadcasts Broadcast[]
  vouchers   Voucher[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id                 String              @id @default(cuid())
  categoryId         String?
  name               String
  nameEn             String?
  slug               String              @unique
  description        String?
  descriptionEn      String?
  imageUrl           String?
  buttonIcon         String              @default("🛍️")
  price              Int
  botPrice           Int                 @default(0)
  webPrice           Int                 @default(0)
  usdtPrice          Decimal?            @db.Decimal(18, 8)
  collaboratorDiscountPercent Int        @default(0)
  showInBot          Boolean             @default(true)
  showInWeb          Boolean             @default(true)
  status             ProductStatus       @default(ACTIVE)
  deliveryType       ProductDeliveryType
  sharedContent      String?
  sharedFilePath     String?
  manualInstructions String              @default("Vui lòng ib admin @vanhdao99 để nhận hàng.")
  manualStock        Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  orders         Order[]
  reviews        ProductReview[]

  @@index([categoryId])
  @@index([status])
}

model ProductReview {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model InventoryItem {
  id        String          @id @default(cuid())
  productId String
  content   String
  status    InventoryStatus @default(AVAILABLE)
  orderId   String?
  soldAt    DateTime?
  createdAt DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

model Order {
  id              String            @id @default(cuid())
  code            String            @unique
  checkoutGroupId String?
  userId          String
  productId       String
  quantity        Int               @default(1)
  unitPrice       Int
  subtotalAmount  Int               @default(0)
  discountAmount  Int               @default(0)
  collaboratorDiscountPercent Int   @default(0)
  collaboratorDiscountAmount  Int   @default(0)
  voucherDiscountAmount       Int   @default(0)
  customerRoleSnapshot        CustomerRole @default(CUSTOMER)
  totalAmount     Int
  status          OrderStatus
  manualStatus    ManualOrderStatus @default(PENDING)
  paymentMethod   PaymentMethod
  voucherCode     String?
  voucherId       String?
  deliveryText    String?
  expiresAt       DateTime?
  fulfilledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user              TelegramUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  voucher           Voucher?            @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  payments          Payment[]
  inventoryItems    InventoryItem[]
  walletEntries     WalletLedgerEntry[]
  voucherRedemption VoucherRedemption?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([manualStatus, createdAt])
  @@index([voucherId])
  @@index([checkoutGroupId])
  @@index([customerRoleSnapshot, createdAt])
}

model Voucher {
  id                String   @id @default(cuid())
  code              String   @unique
  discountPercent   Int
  maxDiscountAmount Int?
  maxDiscountUsdt   Decimal? @db.Decimal(18, 8)
  active            Boolean  @default(true)
  firstOrderOnly    Boolean  @default(false)
  allowCollaboratorStacking Boolean @default(false)
  maxUses           Int?
  usedCount         Int      @default(0)
  startsAt          DateTime @default(now())
  expiresAt         DateTime
  createdByAdminId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy   Admin?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  orders      Order[]
  redemptions VoucherRedemption[]

  @@index([active, expiresAt])
  @@index([createdByAdminId])
}

model VoucherRedemption {
  id                   String   @id @default(cuid())
  voucherId            String
  userId               String
  orderId              String   @unique
  subtotalAmount       Int
  discountAmount       Int
  totalAmount          Int
  claimIpHash          String?
  claimFingerprintHash String?
  createdAt            DateTime @default(now())

  voucher Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId])
  @@unique([voucherId, claimFingerprintHash])
  @@index([userId, createdAt])
  @@index([voucherId, createdAt])
  @@index([voucherId, claimIpHash])
}

model Payment {
  id                String        @id @default(cuid())
  code              String        @unique
  kind              PaymentKind
  status            PaymentStatus
  amount            Int
  expectedAmount    Int?
  userId            String?
  orderId           String?
  expiresAt         DateTime?
  qrImageUrl        String?
  qrPayload         String?
  provider          String        @default("sepay")
  cryptoCurrency    String?
  cryptoAmount      Decimal?      @db.Decimal(18, 8)
  providerPaymentId String?
  checkoutUrl       String?
  deeplink          String?
  providerPayload   Json?
  telegramChatId    String?
  telegramMessageId Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user             TelegramUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  walletEntries    WalletLedgerEntry[]
  bankTransactions BankTransaction[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([orderId])
}

model WalletLedgerEntry {
  id                 String          @id @default(cuid())
  userId             String
  amount             Int
  type               WalletEntryType
  referencePaymentId String?
  referenceOrderId   String?
  note               String?
  createdAt          DateTime        @default(now())

  user             TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  referencePayment Payment?     @relation(fields: [referencePaymentId], references: [id], onDelete: SetNull)
  referenceOrder   Order?       @relation(fields: [referenceOrderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([referencePaymentId])
  @@index([referenceOrderId])
}

model BankTransaction {
  id                    String    @id @default(cuid())
  provider              String    @default("sepay")
  providerTransactionId String    @unique
  gateway               String?
  transactionDate       DateTime?
  accountNumber         String?
  subAccount            String?
  code                  String?
  content               String?
  transferType          String?
  transferAmount        Int
  accumulated           Int?
  referenceCode         String?
  rawPayload            Json
  paymentId             String?
  createdAt             DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([paymentId])
}

model Broadcast {
  id               String          @id @default(cuid())
  title            String
  message          String
  status           BroadcastStatus @default(DRAFT)
  target           String          @default("all")
  sentCount        Int             @default(0)
  failedCount      Int             @default(0)
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  createdBy  Admin?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  deliveries BroadcastDelivery[]
}

model BroadcastDelivery {
  id          String                  @id @default(cuid())
  broadcastId String
  userId      String
  status      BroadcastDeliveryStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime                @default(now())

  broadcast Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorAdminId String?
  action       String
  entityType   String
  entityId     String?
  meta         Json?
  createdAt    DateTime @default(now())

  actorAdmin Admin? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([actorAdminId, createdAt])
  @@index([entityType, entityId])
}
