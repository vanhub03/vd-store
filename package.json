{
  "name": "vd-store",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram sales bot with admin dashboard and VietQR/SePay wallet payments.",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @vd-store/api --filter @vd-store/bot --filter @vd-store/admin dev",
    "dev:api": "pnpm --filter @vd-store/api dev",
    "dev:bot": "pnpm --filter @vd-store/bot dev",
    "dev:admin": "pnpm --filter @vd-store/admin dev",
    "dev:web": "pnpm --filter @vd-store/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "smoke:partner:prod": "node scripts/smoke-partner-production.mjs",
    "product-art:apply": "node scripts/apply-product-art.mjs",
    "prisma:generate": "pnpm --filter @vd-store/api prisma:generate",
    "prisma:migrate": "pnpm --filter @vd-store/api prisma:migrate",
    "prisma:seed": "pnpm --filter @vd-store/api prisma:seed"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
